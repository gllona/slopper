# Local overrides. Copy to .env (never commit .env).
# Locally, Claude Code uses your logged-in session: no token needed here.
# Precedence: CLI flag > environment (.env) > slopper.config.json > code default.

# VETO_MODE=window
# PUBLISH_HOUR_UTC=19
# VETO_MIN_MINUTES=60
DRY_RUN=true
SITE_URL=http://localhost:8080
# LAUNCH_DATE=2026-10-15

# Any top-level numeric tunable in slopper.config.json can be overridden with
# SLOPPER_<SCREAMING_SNAKE_CASE>, e.g.:
# SLOPPER_MAX_ART_ITERATIONS=2
