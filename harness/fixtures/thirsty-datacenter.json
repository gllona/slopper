{
  "harness": "0.2",
  "style": "riso-duotone",
  "background": { "type": "sky-ground", "horizon": 0.8 },
  "elements": [
    { "id": "dc", "component": "datacenter", "at": { "x": 0.66, "y": 0.8 }, "scale": 1.25, "props": { "racks": 4, "steam": true, "lights": "busy" } },
    { "id": "bot", "component": "robot", "at": { "x": 0.2, "y": 0.8 }, "scale": 0.85, "props": { "mood": "neutral" } },
    { "id": "tag", "component": "label", "at": "top-center", "props": { "text": "Day 4", "size": "lg", "kind": "tag" } }
  ],
  "animation": {
    "durationSec": 6,
    "beats": [
      { "t": 0, "target": "bot", "action": "walk-in", "from": "left", "dur": 1.8 },
      { "t": 0.4, "target": "tag", "action": "pop" },
      { "t": 2.0, "target": "dc", "action": "shake", "dur": 0.8 },
      { "t": 2.2, "target": "bot", "action": "set", "props": { "mood": "worried" }, "dur": 0.3 },
      { "t": 3.2, "target": "bot", "action": "set", "props": { "mood": "exhausted" }, "dur": 0.3 },
      { "t": 3.6, "target": "bot", "action": "faint" }
    ],
    "holdSec": 2,
    "ambient": { "target": "dc", "action": "blink" }
  },
  "alt": "A tired robot walks up to a huge steaming datacenter under a sign that says Day 4; the datacenter shakes and the robot faints."
}
